import numpy as np
from utils import objects as ob
from utils import soa as SOA

# Initialize multibody system
robot = ob.MultiBodySystem()

# --- 1. AUTOMATED STADIUM CHAIN GENERATION ---
N_s = 6  # Number of straight links per top/bottom edge
N_c = 6  # Number of curved links per left/right edge
N = 2 * N_s + 2 * N_c  # Total = 24 links
L = 1.1  # Length of each link

# We need exactly 23 relative angles for the 23 spherical joints to close the loop:
# - Bottom straight: 5 joints of 0 degrees
# - Right curve: 6 joints turning by 30 degrees (pi/6)
# - Top straight: 6 joints of 0 degrees
# - Left curve: 6 joints turning by 30 degrees (pi/6)
rel_angles = [0.0]*(N_s - 1) + [np.pi/N_c]*N_c + [0.0]*N_s + [np.pi/N_c]*N_c

# --- 2. POSITIONING THE BASE ---
# Shift X left by half the straight section to center it at X=0
start_x = - (N_s * L) / 2

# Sprockets are at Z=0 with radius 2 (spanning Z=-2 to Z=2).
# We spawn the bottom straight at Z = -2.05 to give it 5cm of clearance.
start_z = 2.05
pos_base = np.array([start_x, 0.0, start_z])

# Rotate the base 90 degrees around Y so it lays perfectly horizontal
quat_base = SOA.quatfromrev(np.pi/2, "y")

# --- 3. BUILD THE SYSTEM PROGRAMMATICALLY ---
# Loop backwards so the Base joint is added first, matching your old setup
for i in range(N, 0, -1):
    if i == N:
        # BASE JOINT (FreeJoint)
        joint = ob.FreeJoint()
        joint.q_init = np.concatenate([quat_base, pos_base])
    else:
        # INTERNAL JOINTS (Spherical)
        joint = ob.SphericalJoint()
        # Map our angle array to the joints
        angle_idx = (N - 1) - i 
        joint.q_init = SOA.quatfromrev(rel_angles[angle_idx], "y")
        
    # Create the link (Reduced mass to 2.0 so 24 links don't weigh ~500 kg)
    link = ob.Link(mass=2.0, l_hinge=np.array([0, 0, L]), joint=joint)
    
    # Add to system
    robot.add_link(link)

# --- 4. SIMULATION PARAMETERS ---
tspan = np.arange(0, 5, 0.001)

V_base = np.zeros(6)
A_base = np.zeros(6)
A_base[-1] = 9.81 # Gravity in Z

# Verify the geometry! You should see a perfect Stadium shape hovering over the sprockets.
robot.plot_initial_state("closed")

# Run the simulation (Make sure config string matches your combined method)
# k = 1,000,000 (solid sprockets)
# c = 2,500 (Critical damping for the lighter 2kg links so it settles smoothly)
robot.simulate(
    tspan, V_base, A_base, 
    config="wall_penalty_CL", 
    BG_params=[0, 250], 
    Penalty_params=[1000000, 2500] 
)

robot.animation(config="closed", step=20)