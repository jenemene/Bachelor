import numpy as np
from utils import soa as SOA

# If running as a separate file, uncomment the line below and replace 'your_filename'
from utils.objects import MultiBodySystem, Link, RevoluteJoint

def run_lambda_equivalence_test():
    print("--- SOA Lambda Equivalence Test ---")
    
    # 1. Initialize your System
    sys = MultiBodySystem()
    
    # Adding 3 Revolute links (to avoid quaternion normalization in a random state)
    sys.add_link(Link(mass=1.2, l_hinge=np.array([0.0, 0.0, -1.0]), joint=RevoluteJoint("x")))
    sys.add_link(Link(mass=0.8, l_hinge=np.array([0.0, 0.0, -1.0]), joint=RevoluteJoint("y")))
    sys.add_link(Link(mass=1.5, l_hinge=np.array([0.0, 0.0, -0.5]), joint=RevoluteJoint("z")))
    
    n = len(sys.links)
    
    # 2. Set a random non-zero state so rotations are active
    state_random = np.random.rand(sys.total_nq + sys.total_nw)
    theta_list, beta_list = sys.unpack_state(state_random)
    
    # 3. Extract the required ATBI operators (tau_bar, D)
    V_base = np.zeros(6)
    A_base = np.zeros(6)
    tau_list = [np.zeros(link.joint.nw) for link in sys.links]
    
    # We unpack only what we need from run_ATBI
    _, _, _, tau_bar, D, _ = sys.run_ATBI(theta_list, beta_list, tau_list, V_base, A_base)
    
    # 4. Calculate Diagonal Omegas using your function
    omega_diag = sys.get_omega_diag(theta_list, tau_bar, D, n)
    
    # --- BOUNDARY CONDITIONS (Direct from your get_state_dot_closed) ---
    link1 = sys.links[0]
    linkn = sys.links[-1]
    
    IR1 = SOA.get_rotation_tip_to_body_I(theta_list, sys.links, n)
    IRn = linkn.joint.get_spatial_rotation(theta_list[-1])

    # ==========================================
    # METHOD A: YOUR ORIGINAL METHOD
    # ==========================================
    # Calls your exact get_omega_ij with the cRp matrix on the left
    omega_n1_old = sys.get_omega_ij(n, 1, theta_list, tau_bar, omega_diag, n)
    
    # Assembled with IR1 on both sides, exactly as you wrote it
    Lambda_n1_old = IR1 @ (omega_n1_old @ link1.RBT) @ IR1.T

    # ==========================================
    # METHOD B: TEXTBOOK METHOD (Two-Point Tensor)
    # ==========================================
    def get_omega_ij_textbook(i, j):
        current_omega = omega_diag[i]
        
        # Replicating your 1-based indexing shift
        theta = [None]*(n+2)
        for idx in range(1, n+1):
            theta[idx] = theta_list[idx-1]
            
        # Downward propagation WITHOUT the left-sided cRp
        for k in range(i-1, j-1, -1):
            link_k = sys.links[k-1]
            pRc = link_k.joint.get_spatial_rotation(theta[k])
            
            # The exact textbook mathematical loop
            current_omega = current_omega @ link_k.RBT @ pRc @ tau_bar[k]
            
        return current_omega

    omega_n1_new = get_omega_ij_textbook(n, 1)
    
    # Assembled with IRn on the left, IR1.T on the right
    Lambda_n1_new = IRn @ (omega_n1_new @ link1.RBT) @ IR1.T

    # ==========================================
    # THE PROOF
    # ==========================================
    print(f"\nLambda_n1 (Old Method) Norm: {np.linalg.norm(Lambda_n1_old):.6f}")
    print(f"Lambda_n1 (New Method) Norm: {np.linalg.norm(Lambda_n1_new):.6f}")
    
    match = np.allclose(Lambda_n1_old, Lambda_n1_new)
    print(f"\nDo the final assembled Lambda matrices match perfectly? >>> {match}")
    print(f"Maximum absolute element difference: {np.max(np.abs(Lambda_n1_old - Lambda_n1_new)):.2e}\n")

if __name__ == "__main__":
    run_lambda_equivalence_test()